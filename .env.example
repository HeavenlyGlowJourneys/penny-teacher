# Client (build-time / Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key

# Comma-separated founder allowlist (client gate for /founder + private tools)
# Example: VITE_FOUNDER_EMAILS=you@example.com,ops@example.com
VITE_FOUNDER_EMAILS=

# Server (Cloudflare Worker secrets / .env — never commit real values)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-side founder allowlist (optional; defaults to VITE_FOUNDER_EMAILS)
# FOUNDER_EMAILS=you@example.com,ops@example.com


# Required bearer for cron, email queue, and internal email send.
# The Supabase service-role key is not accepted in its place.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace_with_long_random_secret

# PayFast (live)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Resend
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# Supabase Auth "Send Email" hook (Standard Webhooks)
SUPABASE_AUTH_HOOK_SECRET=v1,whsec_...

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Prep Check — set true to allow any signed-in user (default: founder-only)
# VITE_PREP_CHECK_PUBLIC=false
# PREP_CHECK_PUBLIC=false

# Oral Assessment Tool — set true to allow any signed-in user (default: founder-only)
# VITE_ORAL_ASSESSMENT_PUBLIC=false
# ORAL_ASSESSMENT_PUBLIC=false
